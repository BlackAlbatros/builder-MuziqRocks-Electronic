#!/usr/bin/env sh
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$HERE/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper JAR missing, attempting to download via scripts/fetch-wrapper.sh"
  sh "$HERE/scripts/fetch-wrapper.sh"
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Failed to obtain gradle-wrapper.jar — attempting to fallback to system 'gradle' command."
  if command -v gradle >/dev/null 2>&1; then
    echo "Using system gradle."
    exec gradle "$@"
  else
    echo "Gradle wrapper not found and 'gradle' command is not installed. Please install Gradle or ensure gradle-wrapper.jar exists." >&2
    exit 1
  fi
fi

exec java -jar "$WRAPPER_JAR" "$@"
