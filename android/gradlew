#!/usr/bin/env sh
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$HERE/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper JAR missing, attempting to download via scripts/fetch-wrapper.sh"
  sh "$HERE/scripts/fetch-wrapper.sh"
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Failed to obtain gradle-wrapper.jar. Please ensure you have Gradle installed and run 'gradle wrapper' inside the android directory." >&2
  exit 1
fi

exec java -jar "$WRAPPER_JAR" "$@"
